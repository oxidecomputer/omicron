<!-- Users, roles, profiles, and quotas for the Oximeter ClickHouse database.

     This block is shared between the single-node and replicated server configs,
     and the config generated by clickhouse-admin. It is merged into the main
     server configuration via the `<users_config>` element, and embedded into the
     clickhouse-admin-generated config with `include_str!()`. See
     https://clickhouse.com/docs/concepts/features/configuration/server-config/configuration-files#merging

     Note: ClickHouse requires that the `<users>`, `<profiles>`, and `<quotas>`
     elements all live in the users config file, not the main config.
-->
<clickhouse>
    <users>
        <!-- Default user is still admin -->
        <default>
            <no_password/>
            <!-- Only available from the same host as the server. Note that this
                 isn't strictly _localhost_, but from any address that the host
                 currently has. See https://github.com/ClickHouse/ClickHouse/blob/6f5373e9a821dd593866f044d5244c807d8873fb/src/Access/Common/AllowedClientHosts.cpp#L70.
            -->
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>

        <!-- A read-only user, e.g., Nexus serving OxQL queries -->
        <reader>
            <no_password/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>oximeter_reader</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON oximeter.*</query>
            </grants>
        </reader>

        <!-- A writeable user, i.e., Oximeter -->
        <writer>
            <no_password/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>oximeter_writer</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT, SELECT ON oximeter.*</query>
            </grants>
        </writer>
    </users>

    <profiles>
        <!-- A read-only profile intended just for querying Oximeter through OxQL -->
        <oximeter_reader>
            <!-- Only allow SELECT or SET at a single-query level -->
            <readonly>2</readonly>
            <!-- Deny CREATE / DROP / ALTER and a bunch of other stuff.
                 See https://clickhouse.com/docs/concepts/features/configuration/settings/permissions-for-queries#allow_ddl
            -->
            <allow_ddl>0</allow_ddl>
            <!-- Cannot read internals about ClickHouse binary -->
            <allow_introspection_functions>0</allow_introspection_functions>
            <max_execution_time>60</max_execution_time>
            <constraints>
                <!-- Constraints on the above settings, i.e., this role can't change them -->
                <readonly>
                    <readonly/>
                </readonly>
                <allow_ddl>
                    <readonly/>
                </allow_ddl>
                <allow_introspection_functions>
                    <readonly/>
                </allow_introspection_functions>
                <max_execution_time>
                    <readonly/>
                </max_execution_time>
            </constraints>
        </oximeter_reader>

        <!-- A profile with write permissions, intended for Oximeter to insert its data -->
        <oximeter_writer>
            <readonly>0</readonly>
            <allow_ddl>0</allow_ddl>
            <allow_introspection_functions>0</allow_introspection_functions>
            <max_execution_time>60</max_execution_time>
            <constraints>
                <allow_ddl>
                    <readonly/>
                </allow_ddl>
                <allow_introspection_functions>
                    <readonly/>
                </allow_introspection_functions>
            </constraints>
        </oximeter_writer>

        <!-- Base profile that has to exist for ClickHouse to start, and all
             users inherit from it. -->
        <default>
            <log_queries_min_query_duration_ms>5</log_queries_min_query_duration_ms>
        </default>
    </profiles>

    <quotas>
        <!-- An unlimited default quota. -->
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
